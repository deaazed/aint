# Copy to `.env` (gitignored) and fill in a real key to point `aint
# run`/`aint scaffold` at a real model instead of the unconfigured
# mock. Any OpenAI-compatible chat completions endpoint works — the
# project's own live verification uses Mistral's API.
#
# These are plain environment variables, not read from this file
# automatically - source it yourself (`set -a; . .env; set +a` on a
# POSIX shell) or set the three manually before running `aint`.

AINT_MODEL_URL=https://api.mistral.ai/v1
AINT_MODEL_NAME=mistral-small-latest
AINT_MODEL_API_KEY=
