import string
import collections

// Imported only by main.an - every page file gets what it needs
// (join_lines, shell_block) passed in or duplicated locally, since
// milestone 29's loader doesn't support the same file being imported
// from two places yet (a "diamond" import). See
// docs/milestones/33-website-rebuild/SPEC.md.

fn join_lines(lines: List<String>, index: Int) -> String {
    if index < collections_length(lines) {
        return string_concat(lines[index], string_concat("\n", join_lines(lines, index + 1)))
    } else {
        return ""
    }
}

fn head(title: String, description: String) -> String {
    return join_lines([
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
        string_concat("<title>", string_concat(title, "</title>")),
        string_concat("<meta name=\"description\" content=\"", string_concat(description, "\">")),
        "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
        "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
        "<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">",
        "<style>",
        style_reset(),
        style_layout(),
        style_type(),
        style_nav(),
        style_hero(),
        style_code(),
        style_sections(),
        style_stats(),
        style_docs(),
        style_footer(),
        "</style>",
        "</head>",
        "<body>"
    ], 0)
}

fn nav() -> String {
    return join_lines([
        "<nav class=\"nav\"><div class=\"wrap-wide navrow\">",
        "<a class=\"wordmark plain\" href=\"/\">aint</a>",
        "<div class=\"navlinks\">",
        "<a href=\"/demos\">Demos</a>",
        "<a href=\"/docs/install\">Install</a>",
        "<a href=\"/docs/quickstart\">Quickstart</a>",
        "<a href=\"/docs/guide\">Guide</a>",
        "<a href=\"/docs/stdlib\">Stdlib</a>",
        "<a href=\"/docs/reference\">Reference</a>",
        "<a href=\"https://github.com/deaazed/aint\">GitHub ↗</a>",
        "</div>",
        "</div></nav>"
    ], 0)
}

fn page_footer() -> String {
    return join_lines([
        "<footer><div class=\"wrap\">",
        "<p class=\"muted\">AINT is <a class=\"plain\" href=\"https://github.com/deaazed/aint/blob/main/LICENSE-MIT\">MIT</a> / <a class=\"plain\" href=\"https://github.com/deaazed/aint/blob/main/LICENSE-APACHE\">Apache-2.0</a> licensed. <a class=\"plain\" href=\"https://github.com/deaazed/aint\">Source on GitHub</a>.</p>",
        "</div></footer>",
        "</body>",
        "</html>"
    ], 0)
}

fn doc_page(title: String, description: String, crumb: String, body_content: String) -> String {
    return string_concat(
        head(title, description),
        string_concat(
            nav(),
            string_concat(
                "<section><div class=\"wrap docs\">",
                string_concat(
                    string_concat("<div class=\"breadcrumb\"><a href=\"/docs\">docs</a> / ", string_concat(crumb, "</div>")),
                    string_concat(body_content, string_concat("</div></section>", page_footer()))
                )
            )
        )
    )
}

fn shell_block(content: String) -> String {
    return string_concat("<div class=\"code\"><pre>", string_concat(content, "</pre></div>"))
}

// --- styles -----------------------------------------------------------

fn style_reset() -> String {
    return string_concat(
        "*{box-sizing:border-box;margin:0;padding:0}",
        "html{-webkit-font-smoothing:antialiased;scroll-behavior:smooth}"
    )
}

fn style_layout() -> String {
    return join_lines([
        "body{background:#0a0a0c;color:#f2f1ec;font-family:'Space Grotesk',system-ui,sans-serif;line-height:1.55}",
        ".wrap{max-width:760px;margin:0 auto;padding:0 24px}",
        ".wrap-wide{max-width:920px;margin:0 auto;padding:0 24px}",
        "section{padding:72px 0}",
        "@media (max-width:640px){section{padding:44px 0}}"
    ], 0)
}

fn style_type() -> String {
    return join_lines([
        "h1,h2,h3{font-weight:700;letter-spacing:-0.02em}",
        "h1{font-size:clamp(2.4rem,6vw,4rem);line-height:1.05}",
        "h2{font-size:clamp(1.5rem,3.4vw,2rem);margin-bottom:18px}",
        "h3{font-size:1.1rem;margin-bottom:10px}",
        "p{color:#b8b7b0;font-size:1.05rem}",
        "p.lede{color:#d8d7d0;font-size:1.2rem;max-width:620px}",
        "a{color:#ffb454}",
        "a.plain{color:inherit;text-decoration:none;border-bottom:1px solid #333}",
        ".muted{color:#7c7b76}",
        ".accent{color:#ffb454}",
        "code.inline{font-family:'JetBrains Mono',monospace;background:#151317;color:#ffb454;padding:2px 6px;border-radius:4px;font-size:0.9em}"
    ], 0)
}

fn style_nav() -> String {
    return join_lines([
        ".nav{border-bottom:1px solid #1c1c1f;padding:18px 0}",
        ".navrow{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}",
        ".navrow .wordmark{font-weight:700;font-size:1.15rem}",
        ".navlinks{display:flex;gap:22px;flex-wrap:wrap;font-family:'JetBrains Mono',monospace;font-size:0.82rem}",
        ".navlinks a{color:#b8b7b0;text-decoration:none}",
        ".navlinks a:hover{color:#ffb454}"
    ], 0)
}

fn style_hero() -> String {
    return join_lines([
        ".hero{padding:80px 0 64px;border-bottom:1px solid #1c1c1f}",
        ".hero h1{margin:8px 0 20px}",
        ".hero .tag{color:#7c7b76;font-family:'JetBrains Mono',monospace;font-size:0.95rem;margin-bottom:28px}",
        ".cta-row{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap}",
        ".btn{display:inline-block;padding:12px 22px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:0.92rem;text-decoration:none;border:1px solid #333}",
        ".btn-primary{background:#ffb454;color:#0a0a0c;border-color:#ffb454;font-weight:600}",
        ".btn-ghost{color:#f2f1ec}"
    ], 0)
}

fn style_code() -> String {
    return join_lines([
        ".code{background:#111113;border:1px solid #1c1c1f;border-radius:10px;padding:24px;overflow-x:auto;margin:20px 0}",
        ".code pre{font-family:'JetBrains Mono',monospace;font-size:0.88rem;line-height:1.65;color:#d8d7d0;white-space:pre}",
        ".kw{color:#ffb454}",
        ".tp{color:#7fd6c2}",
        ".st{color:#c8d67f}",
        ".cm{color:#5f5e5a}"
    ], 0)
}

fn style_sections() -> String {
    return join_lines([
        ".section-border{border-bottom:1px solid #1c1c1f}",
        ".grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:36px}",
        "@media (max-width:720px){.grid3{grid-template-columns:1fr}}",
        ".card h3{margin-bottom:10px}",
        ".card p{font-size:0.95rem}",
        ".card .kicker{font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:#ffb454;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:10px;display:block}"
    ], 0)
}

fn style_stats() -> String {
    return join_lines([
        ".stats{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:8px}",
        "@media (max-width:720px){.stats{grid-template-columns:repeat(2,1fr)}}",
        ".stat b{display:block;font-family:'JetBrains Mono',monospace;font-size:1.9rem;color:#ffb454}",
        ".stat span{font-size:0.85rem;color:#7c7b76}",
        ".stats-note{margin-top:28px;font-size:0.88rem;color:#5f5e5a}"
    ], 0)
}

fn style_docs() -> String {
    return join_lines([
        ".docs h2{margin-top:48px}",
        ".docs h2:first-child{margin-top:0}",
        ".breadcrumb{font-family:'JetBrains Mono',monospace;font-size:0.82rem;color:#7c7b76;margin-bottom:28px}",
        ".breadcrumb a{color:#7c7b76}",
        "ul.doc-list{margin:16px 0 16px 22px}",
        "ul.doc-list li{color:#b8b7b0;margin-bottom:8px}",
        "ol.doc-steps{margin:16px 0 16px 22px}",
        "ol.doc-steps li{color:#b8b7b0;margin-bottom:14px}",
        ".callout{background:#151317;border-left:3px solid #ffb454;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0}",
        ".callout p{color:#d8d7d0;font-size:0.95rem;margin:0}",
        ".docs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:8px}",
        "@media (max-width:640px){.docs-grid{grid-template-columns:1fr}}",
        ".doc-tile{background:#111113;border:1px solid #1c1c1f;border-radius:10px;padding:20px;text-decoration:none;display:block}",
        ".doc-tile h3{color:#f2f1ec;font-size:1rem;margin-bottom:6px}",
        ".doc-tile p{font-size:0.88rem;margin:0;color:#8a8983}",
        ".doc-tile:hover{border-color:#ffb454}",
        "table.stdlib{width:100%;border-collapse:collapse;margin-top:16px;font-size:0.92rem}",
        "table.stdlib th,table.stdlib td{text-align:left;padding:10px 14px;border-bottom:1px solid #1c1c1f;vertical-align:top}",
        "table.stdlib th{color:#7c7b76;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:0.76rem;text-transform:uppercase;letter-spacing:0.04em}",
        "table.stdlib td code{font-family:'JetBrains Mono',monospace;color:#ffb454;font-size:0.85rem}",
        "table.stdlib td.mod{font-family:'JetBrains Mono',monospace;color:#f2f1ec;white-space:nowrap}"
    ], 0)
}

fn style_footer() -> String {
    return join_lines([
        "footer{padding:48px 0;text-align:center}",
        "footer p{font-size:0.88rem}"
    ], 0)
}
