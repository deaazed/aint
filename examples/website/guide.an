import string
import collections

fn join_lines(lines: List<String>, index: Int) -> String {
    if index < collections_length(lines) {
        return string_concat(lines[index], string_concat("\n", join_lines(lines, index + 1)))
    } else {
        return ""
    }
}

fn content(shell_block: fn(String) -> String) -> String {
    return join_lines(["<h2>Language guide</h2>", "<p class=\"lede\">The essentials, in the order you'd actually hit them. For every detail: the <a href=\"https://github.com/deaazed/aint/blob/main/docs/SPECIFICATION.md\">full specification</a>.</p>", "<h2>Types</h2>", "<p><code class=\"inline\">Int</code>, <code class=\"inline\">Float</code>, <code class=\"inline\">Bool</code>, <code class=\"inline\">String</code>, <code class=\"inline\">Unit</code>, <code class=\"inline\">List&lt;T&gt;</code>, <code class=\"inline\">Option&lt;T&gt;</code>, and user-declared <code class=\"inline\">enum</code>s. Static and nominal throughout — no implicit numeric coercion, no dynamic typing anywhere, AI involvement included.</p>", "<h2>let, not variables</h2>", "<p><code class=\"inline\">let name = expr</code> introduces a new binding. There is no reassignment anywhere in the grammar — no <code class=\"inline\">name = new_value</code> statement exists. This is load-bearing, not a style choice: it's what makes capturing a closure's environment by reference sound (milestone 30), and what makes the compiler's AIR-level call deduplication provably sound.</p>", "<h2>Control flow: if/else, and recursion</h2>", "<p>AINT has no loops. <code class=\"inline\">if</code>/<code class=\"inline\">else</code> is the only branching construct — <code class=\"inline\">else</code> is always followed by a block, so an <code class=\"inline\">else if</code> chain is nested <code class=\"inline\">if</code>s inside <code class=\"inline\">else</code>. Iteration is recursion; the bytecode VM's call frames live on the heap specifically so deep recursion doesn't need a bigger stack.</p>", "<h2>Functions, effects, and closures</h2>", "<p><code class=\"inline\">fn name(param: Type) -&gt; ReturnType { ... }</code>, optionally <code class=\"inline\">async</code>. An optional <code class=\"inline\">effects [ ... ]</code> clause — words from <code class=\"inline\">pure</code>, <code class=\"inline\">inference</code>, <code class=\"inline\">tool</code>, <code class=\"inline\">network</code>, <code class=\"inline\">filesystem</code> — is checked by the compiler: a <code class=\"inline\">pure</code> function cannot call anything whose own effects reach wider than <code class=\"inline\">pure</code>. Since milestone 30, <code class=\"inline\">fn(param: Type) -&gt; ReturnType { ... }</code> in expression position is a closure — a function value, passed as an argument, returned, stored in a <code class=\"inline\">List</code>. A plain <code class=\"inline\">fn</code> referenced by name without calling it decays to the same kind of value.</p>", "<h2>infer, tool, and permissions</h2>", "<p><code class=\"inline\">infer name(params) -&gt; Type</code> and <code class=\"inline\">tool name(params) -&gt; Type</code> are signature-only declarations — no body. <code class=\"inline\">await</code>-ing an <code class=\"inline\">infer</code> call sends the request to whatever <code class=\"inline\">Model</code> is configured; <code class=\"inline\">await</code>-ing a <code class=\"inline\">tool</code> call runs it. An <code class=\"inline\">infer</code> can restrict which tools its own model conversation may reach:</p>", shell_block(join_lines(["<span class=\"kw\">infer</span> classify(message: <span class=\"tp\">String</span>) -&gt; Intent", "    <span class=\"kw\">permissions</span> [find_customer]"], 0)), "<p>Checked at compile time (does <code class=\"inline\">find_customer</code> name a real <code class=\"inline\">tool</code>?) and enforced again at runtime, independent of what the model was actually offered.</p>", "<h2>Modularity</h2>", "<p><code class=\"inline\">import \"./path.an\" as alias</code> (milestone 29) makes another file's declarations available as <code class=\"inline\">alias_name</code> — this website is itself split across files this way (<a href=\"https://github.com/deaazed/aint/tree/main/examples/website\">examples/website/</a>). A file reached this way may only declare <code class=\"inline\">fn</code>/<code class=\"inline\">enum</code>/<code class=\"inline\">tool</code>/<code class=\"inline\">infer</code>/<code class=\"inline\">import</code> at its top level, and — for now — may only be imported from exactly one place in the whole program.</p>", "<h2>Uncertainty: Distribution&lt;T&gt;</h2>", "<p><code class=\"inline\">Distribution&lt;T&gt;</code> (over an enum's variants) is a first-class type with <code class=\"inline\">distribution_probability</code>, <code class=\"inline\">distribution_argmax</code>, <code class=\"inline\">distribution_entropy</code>, <code class=\"inline\">distribution_sample</code>, and <code class=\"inline\">distribution_require_confidence</code> — resolving uncertainty is always an explicit decision, never an implicit coercion to a plain value.</p>", "<h2>Testing: test, mock, assert</h2>", "<p><code class=\"inline\">test \"name\" { ... }</code> blocks run via <code class=\"inline\">aint test</code>, each in its own fresh interpreter. <code class=\"inline\">mock function_name -&gt; value</code> configures what a declared <code class=\"inline\">infer</code> or <code class=\"inline\">tool</code> returns, for that test only — no live model call, ever, in a test suite. <code class=\"inline\">assert condition</code> works everywhere, not just in tests.</p>", "<div class=\"callout\"><p>One real constraint worth knowing early: a file can't contain both its own <code class=\"inline\">test</code> blocks and a blocking top-level statement like <code class=\"inline\">await http_serve(...)</code> — <code class=\"inline\">aint test</code> re-runs every non-test statement before each test body, which would re-run the server start and hang. See the <a href=\"/docs/reference\">reference</a> for the full list of constraints like this one.</p></div>", "<h2>budget</h2>", "<p>A single, program-wide resource ceiling, enforced by the runtime:</p>", shell_block(join_lines(["<span class=\"kw\">budget</span> {", "    max_tokens = 5000", "    max_model_calls = 3", "    max_cost = 0.02", "    timeout_ms = 10000", "}"], 0))], 0)
}
