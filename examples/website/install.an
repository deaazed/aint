import string
import collections

fn join_lines(lines: List<String>, index: Int) -> String {
    if index < collections_length(lines) {
        return string_concat(lines[index], string_concat("\n", join_lines(lines, index + 1)))
    } else {
        return ""
    }
}

// `shell_block` is passed in rather than duplicated — it's the same
// wrapper `layout.an` already defines, taken as a closure instead of a
// second copy: exactly the kind of small, dependency-injected sharing
// closures make possible without needing a second import of a file
// already imported once.
fn content(shell_block: fn(String) -> String) -> String {
    return join_lines([
        "<h2>Install</h2>",
        "<p class=\"lede\">Prebuilt binaries, published straight from a tagged release — no Cargo, no Rust toolchain required.</p>",
        "<h2>macOS / Linux</h2>",
        shell_block(curl_shell_lines()),
        "<h2>Windows</h2>",
        shell_block(powershell_lines()),
        "<p>Either script detects your OS/arch, downloads the matching binary from the latest release, and installs it to <code class=\"inline\">~/.aint/bin</code> (<code class=\"inline\">%USERPROFILE%\\.aint\\bin</code> on Windows) — warning if that directory isn't already on your <code class=\"inline\">PATH</code>.</p>",
        "<h2>Verify it worked</h2>",
        shell_block(verify_shell_lines()),
        "<h2>Building from source instead</h2>",
        "<p>Still fully supported — useful on a platform the installer doesn't cover yet, or if you're contributing to the language itself. Requires a recent stable Rust toolchain (<a href=\"https://rustup.rs\">rustup.rs</a>).</p>",
        shell_block(source_shell_lines()),
        "<div class=\"callout\"><p>Prefer <code class=\"inline\">cargo build --release</code> for anything performance-sensitive — the debug build is meaningfully slower, and the bytecode VM's whole point is speed.</p></div>",
        "<p>Next: <a href=\"/docs/quickstart\">the quickstart</a>.</p>"
    ], 0)
}

fn curl_shell_lines() -> String {
    return "curl -fsSL https://raw.githubusercontent.com/deaazed/aint/main/install.sh | sh"
}

fn powershell_lines() -> String {
    return "irm https://raw.githubusercontent.com/deaazed/aint/main/install.ps1 | iex"
}

fn verify_shell_lines() -> String {
    return join_lines([
        "aint --version",
        "<span class=\"cm\"># aint 0.1.1</span>"
    ], 0)
}

fn source_shell_lines() -> String {
    return join_lines([
        "git clone https://github.com/deaazed/aint.git",
        "<span class=\"cm\">cd</span> aint",
        "cargo build --release",
        "./target/release/aint run examples/hello.an",
        "<span class=\"cm\"># Hello, AINT!</span>"
    ], 0)
}
