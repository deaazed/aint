import string
import collections

fn join_lines(lines: List<String>, index: Int) -> String {
    if index < collections_length(lines) {
        return string_concat(lines[index], string_concat("\n", join_lines(lines, index + 1)))
    } else {
        return ""
    }
}

fn content() -> String {
    return join_lines(["<h2>Reference</h2>", "<p class=\"lede\">The condensed version. For the exhaustive one: <a href=\"https://github.com/deaazed/aint/blob/main/docs/SPECIFICATION.md\">docs/SPECIFICATION.md</a>.</p>", "<h2>Two execution engines</h2>", "<p><code class=\"inline\">aint run</code> uses a tree-walking interpreter — the only one that supports <code class=\"inline\">infer</code>/<code class=\"inline\">tool</code>/<code class=\"inline\">async</code>/<code class=\"inline\">await</code>/closures. <code class=\"inline\">aint run --vm</code> uses a stack-based bytecode VM covering AINT's deterministic core only — call frames live on the heap instead of a fixed-size native stack, and it's roughly 13x faster on compute-heavy code. Anything using only the deterministic core runs correctly under <code class=\"inline\">--vm</code> with zero changes; a closure fails clearly rather than silently.</p>", "<h2>Model backends</h2>", "<p><code class=\"inline\">aint run</code> uses an unconfigured mock model by default — every <code class=\"inline\">infer</code> call fails clearly unless <code class=\"inline\">AINT_MODEL_URL</code> is set, in which case it talks to any OpenAI-compatible chat completions endpoint (vLLM, Ollama, OpenAI itself). <code class=\"inline\">aint test</code> always mocks, per test block. <code class=\"inline\">aint scaffold</code> uses the same backend to generate a starter project from a description, always checked before being reported as done.</p>", "<h2>Errors</h2>", "<p><code class=\"inline\">TypeError</code> (parse/type-check time) and <code class=\"inline\">RuntimeError</code> (execution time) — both positioned as <code class=\"inline\">file:line:column: message</code>, except errors from <code class=\"inline\">--vm</code>, which use a placeholder position for now.</p>", "<h2>Known gaps</h2>", "<p>Stated here so they're findable in one place, not discovered mid-project:</p>", "<ul class=\"doc-list\">", "<li>No diamond imports — the same file may only be imported from exactly one place in the whole program (this website's own <code class=\"inline\">layout.an</code> is imported once, by <code class=\"inline\">main.an</code>, for exactly this reason).</li>", "<li>Closures don't run under <code class=\"inline\">aint run --vm</code> — a documented parity gap, not silent miscompilation.</li>", "<li>No generics, structs, or interfaces/traits — closures were deliberately the smallest lever for passing behavior around.</li>", "<li>No <code class=\"inline\">Option&lt;T&gt;</code>/<code class=\"inline\">Distribution&lt;T&gt;</code> construction syntax — only specific natives produce them.</li>", "<li>No list concatenation or incremental list construction.</li>", "<li>No <code class=\"inline\">Int</code>/<code class=\"inline\">String</code> conversion.</li>", "<li><code class=\"inline\">aint test</code> can't exercise a file with a blocking top-level statement (see the guide's callout on this).</li>", "<li>A <code class=\"inline\">tool</code> can have a real, AINT-written implementation, run whether called directly or requested by a model — an explicit <code class=\"inline\">mock</code> still overrides it wherever one's configured, so tests never touch it by accident.</li>", "<li>No LSP, autocomplete, or go-to-definition yet — <code class=\"inline\">aint check</code>/<code class=\"inline\">aint fmt</code> and syntax highlighting exist.</li>", "<li>No hosted package registry — <code class=\"inline\">aint add</code> takes a local path or a git URL, never a bare name looked up somewhere.</li>", "<li><code class=\"inline\">http_serve</code> handles one connection at a time, by construction.</li>", "</ul>", "<div class=\"callout\"><p>This page is itself served by <code class=\"inline\">http_serve</code>, from <a href=\"https://github.com/deaazed/aint/tree/main/examples/website\">examples/website/</a> — a real, multi-file AINT program, its routes registered in a flat table (<a href=\"https://github.com/deaazed/aint/tree/main/examples/router\">examples/router/</a>) instead of nested <code class=\"inline\">if</code>/<code class=\"inline\">else</code>, running right now, with no framework underneath it beyond what AINT itself provides.</p></div>"], 0)
}
