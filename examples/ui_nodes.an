import ui

infer tagline(topic: String) -> Node

fn nav_link(label: String, href: String) -> Node {
    return Button { href: href label }
}

fn hero(title: String, links: List<Node>) -> Node {
    return Group {
        Heading { title }
        Group { links }
    }
}

fn main() -> Unit {
    let links = [nav_link("Docs", "/docs"), nav_link("Try it", "/try")]
    print(render_html(hero("AINT", links)))
}

main()

test "a hand-authored tree and an AI-generated node compose and render together" {
    mock tagline -> Group { Paragraph { "a language that types AI, not just calls it" } }
    let page = Group {
        Heading { "AINT" }
        await tagline("positioning")
    }
    assert render_html(page) == "<div><h2>AINT</h2><div><p>a language that types AI, not just calls it</p></div></div>"
}

test "a role outside the shorthand renders as its own tag, gracefully" {
    let section = Section { "beta" }
    assert render_html(section) == "<section>beta</section>"
}

test "a role that is not a plausible tag name falls back to a labeled div" {
    let badge = Side_Bar { "beta" }
    assert render_html(badge) == "<div data-role=\"Side_Bar\">beta</div>"
}
